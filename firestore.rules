rules_version = '2';

// 원칙: 로그인한 사용자는 users/{자기 uid} 아래만 읽고 쓸 수 있다.
// 쓰기에는 최소한의 형식 검증을 둔다 (잘못된 클라이언트 코드로부터 데이터 보호).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function data() { return request.resource.data; }
    function ownsDoc(uid) { return data().userId == uid; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isDateOrNull(v) { return v == null || isDate(v); }
    function isTimeOrNull(v) { return v == null || (v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$')); }
    function shortText(v, max) { return v is string && v.size() <= max; }

    // 사용자 문서 (설정)
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && ownsDoc(uid)
        && data().settings.dayStartHour is int
        && data().settings.dayStartHour >= 0 && data().settings.dayStartHour <= 6;

      // 활성 타이머 (사용자당 문서 1개)
      match /state/{docId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid) && docId == 'activeTimer' && ownsDoc(uid)
          && (data().sessionId == null || (data().startAt is number && data().subjectId is string));
      }

      match /subjects/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && shortText(data().name, 40) && data().name.size() > 0
          && data().archived is bool;
      }

      match /tasks/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && shortText(data().title, 200) && data().title.size() > 0
          && data().subjectId is string
          && isDateOrNull(data().planDate) && isTimeOrNull(data().planStart) && isDateOrNull(data().dueDate)
          && data().status in ['active', 'skipped', 'archived']
          && data().subtasks is list && data().subtasks.size() <= 50;
      }

      match /recurrences/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && data().freq in ['daily', 'weekly', 'weekdays']
          && isDate(data().startDate) && isDateOrNull(data().endDate);
      }

      match /sessions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && data().subjectId is string
          && data().startAt is number && data().endAt is number
          && data().endAt >= data().startAt
          && data().durationSec is int && data().durationSec >= 0
          && data().durationSec <= (data().endAt - data().startAt) / 1000 + 1
          && isDate(data().studyDate);
      }

      match /timetables/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && isDate(data().validFrom) && isDateOrNull(data().validTo)
          && data().slots is list && data().slots.size() <= 100;
      }

      match /timetableExceptions/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().date == date && isDate(date)
          && data().slots is list && data().slots.size() <= 30;
      }

      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ownsDoc(uid) && data().id == id
          && shortText(data().title, 100) && isDate(data().date) && isDateOrNull(data().endDate);
      }
    }
  }
}
